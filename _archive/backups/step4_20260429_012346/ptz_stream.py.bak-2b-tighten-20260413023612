            else:
                cam_x, cam_y, cam_z, camera_meta = _sample_camera_from_config_box(stage, rng, seed)

            last_seed = seed
            last_attempt = attempt + 1
            _CAMERA_RIG_TRANSLATE_XYZ = (cam_x, cam_y, cam_z)

            if random_cfg["auto_look_at_target"]:
