                    stage,
                    (cam_x, cam_y, cam_z),
                    source="random_scene_api",
                    preset_name="default_initial",
                    target_xyz=target_xyz,
                )

            if not random_cfg["keep_target_visible"]:
                startup_visible = None
                break

            preset_vis, preset_vis_detail = check_preset_visibility(
