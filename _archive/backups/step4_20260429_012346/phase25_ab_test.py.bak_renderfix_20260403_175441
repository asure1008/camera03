#!/usr/bin/env python3
import datetime as dt
import json
import subprocess
import time
import urllib.request
from pathlib import Path
import numpy as np
import yaml
from PIL import Image
import os

CFG_PATH = Path("/home/uniubi/xuanyuan/camera05/camera03/ptz_config.yaml")
OUT_DIR  = Path("/home/uniubi/xuanyuan/camera05/camera03")

RTSP_STABILIZE_S = 3.0
AB_ACTIVE_PATH   = "/World/Diaolan_Ver1_0_2026_01"
AB_CAM_XYZ       = [88.0, -55.0, 33.0]

def write_cfg(cfg: dict) -> None:
    CFG_PATH.write_text(
        yaml.safe_dump(cfg, allow_unicode=True, sort_keys=False), encoding="utf-8"
    )

def grab_frame(tag: str, rtsp_url: str) -> Path:
    ts = dt.datetime.now().strftime("%Y%m%d_%H%M%S")
    out = OUT_DIR / f"_test_4diaolan_{tag}_{ts}.jpg"
    url = rtsp_url.replace("localhost", "127.0.0.1")
    cmd = [
        "ffmpeg", "-y", "-rtsp_transport", "tcp",
        "-i", url, "-frames:v", "1", "-q:v", "2", str(out),
    ]
    for _ in range(5):
        try:
            subprocess.run(cmd, check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=30)
            return out
        except Exception:
            time.sleep(1.5)
    raise RuntimeError("ffmpeg 抓帧失败")

def analyze_image(path: Path) -> dict:
    img = np.array(Image.open(path).convert("RGB"))
    gray = 0.299 * img[:, :, 0] + 0.587 * img[:, :, 1] + 0.114 * img[:, :, 2]
    mean_luma = float(np.mean(gray))
    black_ratio = float(np.mean(gray < 20))
    h, w = gray.shape
    cx0, cx1 = int(w * 0.2), int(w * 0.8)
    cy0, cy1 = int(h * 0.2), int(h * 0.8)
    center_black = float(np.mean(gray[cy0:cy1, cx0:cx1] < 20))
    crop_std = float(np.std(gray[cy0:cy1, cx0:cx1]))
    gx = float(np.abs(np.diff(gray[cy0:cy1, cx0:cx1], axis=1)).mean())
    gy = float(np.abs(np.diff(gray[cy0:cy1, cx0:cx1], axis=0)).mean())
    file_kb = path.stat().st_size / 1024
    return {
        "file_kb":          round(file_kb, 1),
        "mean_luma":        round(mean_luma, 2),
        "black_ratio":      round(black_ratio, 4),
        "center_black":     round(center_black, 4),
        "center_crop_std":  round(crop_std, 2),
        "center_edge_grad": round((gx + gy) * 0.5, 2),
        "非整帧黑":          mean_luma > 18.0 and black_ratio < 0.90,
        "轮廓基本可见":       crop_std > 14.0 and (gx + gy) * 0.5 > 5.5,
    }

def _http(url: str, method: str = "GET", payload: dict | None = None) -> dict:
    data, headers = None, {}
    if payload is not None:
        data = json.dumps(payload).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=25) as r:
        return json.loads(r.read().decode())

def get_status() -> dict:
    return _http("http://127.0.0.1:8081/status")

def run_stream_and_grab(tag: str, rtsp_url: str):
    # Start ptz_stream.py
    cmd = ["/home/uniubi/miniconda3/envs/env_isaaclab/bin/python3", "/home/uniubi/xuanyuan/camera05/camera03/ptz_stream.py", "--config", "ptz_config.yaml"]
    log_file = open(f"/home/uniubi/xuanyuan/camera05/camera03/_ptz_stream_{tag}.log", "w")
    proc = subprocess.Popen(cmd, stdout=log_file, stderr=subprocess.STDOUT, cwd="/home/uniubi/xuanyuan/camera05/camera03")
    
    # Wait for stream to be ready
    deadline = time.time() + 150
    ready = False
    while time.time() < deadline:
        if proc.poll() is not None:
            print(f"ptz_stream.py exited prematurely with code {proc.returncode}")
            break
        try:
            st = get_status()
            stream = st.get("stream") or {}
            print(f"Status: camera_bound_ok={stream.get('camera_bound_ok')} ffmpeg_alive={stream.get('ffmpeg_alive')}")
            if (
                stream.get("camera_bound_ok") is True
                and stream.get("ffmpeg_alive") is True
            ):
                ready = True
                break
        except Exception as e:
            print(f"Status check failed: {e}")
            pass
        time.sleep(1)
    
    if not ready:
        proc.terminate()
        raise RuntimeError(f"Stream not ready after 90s for {tag}")
        
    time.sleep(RTSP_STABILIZE_S)
    
    # Grab frame
    frame_path = grab_frame(tag, rtsp_url)
    
    # Stop stream
    proc.terminate()
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.kill()
        
    log_file.close()
    return frame_path

def phase_ab_one(base_cfg: dict, rtsp_url: str, renderer: str) -> dict:
    cfg = dict(base_cfg)
    cfg["renderer"] = renderer
    cfg["camera_rig_translate_xyz"] = AB_CAM_XYZ
    cfg["force_active_diaolan_path"] = AB_ACTIVE_PATH
    
    # 暂时禁用 force_workers_count / force_gondola_height
    cfg.pop("force_workers_count", None)
    cfg.pop("force_gondola_height", None)
    
    # 暂时不启用随机事件
    cfg["diaolan_camera_sampling_enabled"] = False
    
    write_cfg(cfg)

    tag = f"phase25_ab_{renderer.lower().replace('lighted', 'rt')}"
    frame_path = run_stream_and_grab(tag, rtsp_url)
    iq = analyze_image(frame_path)

    result = {
        "renderer":      renderer,
        "active_path":   AB_ACTIVE_PATH,
        "cam_xyz":       AB_CAM_XYZ,
        "frame_path":    str(frame_path),
        "image_quality": iq,
    }
    print(f"[phase_ab] renderer={renderer} file_kb={iq['file_kb']} "
          f"mean_luma={iq['mean_luma']} black_ratio={iq['black_ratio']} "
          f"center_std={iq['center_crop_std']} 非整帧黑={iq['非整帧黑']} 轮廓可见={iq['轮廓基本可见']}")
    return result

def phase_ab(base_cfg: dict, rtsp_url: str) -> dict:
    print("\n" + "=" * 64)
    print("Phase 2.5D: HydraStorm vs RaytracedLighting A/B 对比")
    print("=" * 64)

    hydra = phase_ab_one(base_cfg, rtsp_url, "HydraStorm")
    rt    = phase_ab_one(base_cfg, rtsp_url, "RaytracedLighting")

    comparison = {
        "HydraStorm":          hydra["image_quality"],
        "RaytracedLighting":   rt["image_quality"],
        "文件大小差(kb)":       round(rt["image_quality"]["file_kb"] - hydra["image_quality"]["file_kb"], 1),
        "平均亮度差":           round(rt["image_quality"]["mean_luma"] - hydra["image_quality"]["mean_luma"], 2),
        "黑像素占比差":         round(rt["image_quality"]["black_ratio"] - hydra["image_quality"]["black_ratio"], 4),
        "中心裁剪标准差差":     round(rt["image_quality"]["center_crop_std"] - hydra["image_quality"]["center_crop_std"], 2),
        "轮廓梯度差":           round(rt["image_quality"]["center_edge_grad"] - hydra["image_quality"]["center_edge_grad"], 2),
    }
    result = {
        "phase":       "2.5D",
        "HydraStorm":  hydra,
        "RaytracedLighting": rt,
        "对比摘要":    comparison,
    }
    print(json.dumps({"Phase2.5D_对比": comparison}, ensure_ascii=False, indent=2))
    return result

def main() -> None:
    original_text = CFG_PATH.read_text(encoding="utf-8")
    base_cfg = yaml.safe_load(original_text) or {}
    rtsp_url = str(base_cfg["rtsp_url"])

    report_path = OUT_DIR / f"_phase25_ab_report_{dt.datetime.now().strftime('%Y%m%d_%H%M%S')}.json"

    try:
        ab_result = phase_ab(base_cfg, rtsp_url)

        report = {
            "Phase2.5D": ab_result,
        }
        report_path.write_text(
            json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8"
        )
        print(f"\n[report] saved → {report_path}")
        print(json.dumps(report, ensure_ascii=False, indent=2))

    finally:
        # 恢复原始配置
        write_cfg(yaml.safe_load(original_text) or {})

if __name__ == "__main__":
    main()
