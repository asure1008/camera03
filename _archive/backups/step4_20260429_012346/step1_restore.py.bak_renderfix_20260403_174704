import os
import time
import subprocess
import yaml
import psutil
import cv2
import numpy as np

# 1. Modify config
with open("ptz_config.yaml", "r") as f:
    cfg = yaml.safe_load(f)

cfg["scene_path"] = "/home/uniubi/xuanyuan/camera05/camera03/scene_single_with_ptz.usda"
cfg["renderer"] = "RaytracedLighting"
cfg["diaolan_camera_sampling_enabled"] = False
cfg["camera_rig_translate_xyz"] = [84.2, 10.87, 6.53]

with open("ptz_config.yaml", "w") as f:
    yaml.dump(cfg, f)

# 2. Stop all
subprocess.run(["./stop_all.sh"], capture_output=True)
time.sleep(2)

# 3. Start
print("Starting...")
proc = subprocess.Popen(["./start_safe.sh"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

# 4. Wait for stream
success = False
img_path = "_step1_frame.jpg"
for i in range(150):
    time.sleep(1)
    ret = subprocess.run(["ffmpeg", "-y", "-rtsp_transport", "tcp", "-i", "rtsp://localhost:8554/ptz_cam", "-vframes", "1", "-q:v", "2", img_path], capture_output=True)
    if ret.returncode == 0 and os.path.exists(img_path):
        success = True
        break

# 5. Check ports and memory
ports_ok = True
for port in [8080, 8081, 8554]:
    ret = subprocess.run(f"netstat -tulpn 2>/dev/null | grep ':{port}'", shell=True, capture_output=True)
    if ret.returncode != 0:
        ports_ok = False

mem_mb = 0
for p in psutil.process_iter(['name', 'cmdline']):
    try:
        cmdline = " ".join(p.info['cmdline'] or [])
        if "ptz_stream.py" in cmdline and "step1" not in cmdline:
            mem_mb = p.memory_info().rss / (1024 * 1024)
            break
    except:
        pass

# 6. Check image
black_ratio = 1.0
if success:
    img = cv2.imread(img_path)
    if img is not None:
        gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
        black_ratio = np.sum(gray < 10) / gray.size

# 7. Stop
subprocess.run(["./stop_all.sh"], capture_output=True)

print(f"RESULT: success={success}, ports_ok={ports_ok}, mem_mb={mem_mb:.1f}, black_ratio={black_ratio:.4f}")
