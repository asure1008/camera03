#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    subLayers = [
        @./DiaoLan_ChangJing_2026.03.18_unpacked/main.usdc@
    ]
)
over "World"
{
    def Xform "CameraRig"
    {
        double3 xformOp:translate = (82, -72, 28)
        double xformOp:rotateZ = -100
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

        def Xform "CamTilt"
        {
            double xformOp:rotateX = 48
            uniform token[] xformOpOrder = ["xformOp:rotateX"]

            def Camera "Camera"
            {
                float focalLength = 6
                float2 clippingRange = (0.02, 100000)
                double3 xformOp:translate = (0, 0, 0)
                quatd xformOp:orient = (1, 0, 0, 0)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            }
        }
    }

    def DistantLight "KeyLight"
    {
        float intensity = 3000
        color3f color = (1, 1, 1)
        double3 xformOp:rotateXYZ = (-45, 0, 30)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "FillLight"
    {
        float intensity = 650
        color3f color = (1, 1, 1)
    }

    # 补光实验：默认 0 不改变画面；配置 diaolan_ambient_boost_intensity 时由 ptz_stream 写入
    def DomeLight "AmbientBoost"
    {
        float intensity = 0
        color3f color = (1, 1, 1)
    }
}