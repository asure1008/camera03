<script>
// ── Config ────────────────────────────────────────────────────
const HOST     = location.hostname || 'localhost';
const PORT     = location.port || '8080';
const API      = `http://${HOST}:${PORT}`;
const FOCAL_1X = 18.14756;
const MODEL_API = `${API}/runtime/model`;
const PTZ_SELFCHECK_API = `${API}/ptz/selfcheck`;

// ONVIF 默认端点（当前服务）
const DEFAULT_DEVICE_SVC = `http://${HOST}:${PORT}/onvif/device_service`;
const DEFAULT_MEDIA_SVC  = `http://${HOST}:${PORT}/onvif/media_service`;
const DEFAULT_PTZ_SVC    = `http://${HOST}:${PORT}/onvif/ptz_service`;
const RTSP_URL           = `rtsp://${HOST}:8554/ptz_cam`;

// ── Isaac Sim 状态 ─────────────────────────────────────────────
let isaacState = 'stopped';

// ── PTZ State ─────────────────────────────────────────────────
const state = { pan: -56, tilt: 9, zoom: 1 };
const LIMITS = { pan: [-170, 170], tilt: [-90, 30], zoom: [1, 32] };
const presetStore = new Map();

function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

function formatFetchError(err) {
  const msg = (err && err.message ? String(err.message) : String(err || 'unknown error')).trim();
  const lower = msg.toLowerCase();
  if (lower.includes('failed to fetch') || lower.includes('networkerror') || lower.includes('typeerror')) {
    return `无法连接 ${API}`;
  }
  if (lower.includes('aborted') || lower.includes('timeout')) {
    return `请求超时：${API}`;
  }
  return msg || '未知错误';
}

// ── ONVIF 模块状态 ─────────────────────────────────────────────
const onvif = {
  mode: 'local',         // 'local' | 'ext'
  deviceSvc: DEFAULT_DEVICE_SVC,
  mediaSvc:  DEFAULT_MEDIA_SVC,
  ptzSvc:    DEFAULT_PTZ_SVC,
  profileToken: 'PTZProfile_1',
  connected: false,
};

// ── 初始化 Header 信息 ─────────────────────────────────────────
(function initHeader() {
  document.getElementById('p-rtsp').textContent = `▶ ${RTSP_URL}`;
  document.getElementById('p-rtsp').title = `VLC 拉流：${RTSP_URL}`;
  document.getElementById('info-rtsp').textContent = RTSP_URL;
  document.getElementById('info-device-svc').textContent = DEFAULT_DEVICE_SVC;
  document.getElementById('info-snap').textContent = `http://${HOST}:${PORT}/onvif-snap.jpg`;
  document.getElementById('info-ptz-svc').textContent = DEFAULT_PTZ_SVC;
  document.getElementById('input-device-svc').value = DEFAULT_DEVICE_SVC;
  document.getElementById('input-media-svc').value = DEFAULT_MEDIA_SVC;
  document.getElementById('input-ptz-svc').value = DEFAULT_PTZ_SVC;
})();

const modelSceneInput = document.getElementById('model-scene-path');
const modelCameraInput = document.getElementById('model-camera-prim');
const modelRestartInput = document.getElementById('model-restart');
const modelStatusEl = document.getElementById('model-status');
const modelActiveEl = document.getElementById('model-active');
const selfcheckBadgeEl = document.getElementById('selfcheck-badge');
const selfcheckStatusEl = document.getElementById('selfcheck-status');
const selfcheckDetailsEl = document.getElementById('selfcheck-details');

// ── DOM refs ──────────────────────────────────────────────────
const joystick   = document.getElementById('joystick');
const jdot       = document.getElementById('jdot');
const zoomSlider = document.getElementById('zoom-slider');

// ── Joystick ──────────────────────────────────────────────────
const JW = 176, JH = 176;

function stateToPixel() {
  return {
    x: ((state.pan  - (-170)) / 340) * JW,
    y: ((state.tilt - (-90))  / 120) * JH,
  };
}
function pixelToState(px, py) {
  return {
    pan:  clamp((px / JW) * 340 - 170, -170, 170),
    tilt: clamp((py / JH) * 120 - 90,  -90,   30),
  };
}
function updateDotPos() {
  const { x, y } = stateToPixel();
  jdot.style.left = x + 'px';
  jdot.style.top  = y + 'px';
}

let dragging = false;
function getRelPos(e) {
  const rect = joystick.getBoundingClientRect();
  const cx = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
  const cy = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
  return { px: clamp(cx, 0, JW), py: clamp(cy, 0, JH) };
}

joystick.addEventListener('mousedown', e => {
  dragging = true; joystick.classList.add('dragging');
  const { px, py } = getRelPos(e);
  Object.assign(state, pixelToState(px, py));
  updateAll(); scheduleApply();
});
document.addEventListener('mousemove', e => {
  if (!dragging) return;
  const { px, py } = getRelPos(e);
  Object.assign(state, pixelToState(px, py));
  updateAll(); scheduleApply();
});
document.addEventListener('mouseup', () => {
  dragging = false; joystick.classList.remove('dragging');
});
joystick.addEventListener('touchstart', e => {
  e.preventDefault(); dragging = true; joystick.classList.add('dragging');
  Object.assign(state, pixelToState(...Object.values(getRelPos(e))));
  updateAll(); scheduleApply();
}, { passive: false });
document.addEventListener('touchmove', e => {
  if (!dragging) return; e.preventDefault();
  Object.assign(state, pixelToState(...Object.values(getRelPos(e))));
  updateAll(); scheduleApply();
}, { passive: false });
document.addEventListener('touchend', () => { dragging = false; joystick.classList.remove('dragging'); });
joystick.addEventListener('dblclick', () => resetPT());

// ── Zoom slider ───────────────────────────────────────────────
zoomSlider.addEventListener('input', () => {
  state.zoom = parseFloat(zoomSlider.value);
  updateAll(); scheduleApply();
});

// ── Display update ────────────────────────────────────────────
function updateAll() {
  document.getElementById('pan-val').textContent  = state.pan.toFixed(1)  + '°';
  document.getElementById('tilt-val').textContent = state.tilt.toFixed(1) + '°';
  document.getElementById('zoom-val').textContent = state.zoom.toFixed(1) + '×';
  if (!dragging) zoomSlider.value = state.zoom;
  updateDotPos();
}

// ── Presets ───────────────────────────────────────────────────
function presetLabel(token) { return `预置位${token}`; }

function renderPresets() {
  const root = document.getElementById('preset-grid');
  root.innerHTML = '';
  for (let i = 1; i <= 5; i++) {
    const token = String(i);
    const item  = presetStore.get(token);
    const card  = document.createElement('div');
    card.className = 'preset-card';
    card.innerHTML = `
      <div class="preset-head">
        <div class="preset-name">${item?.name || presetLabel(token)}</div>
        <div class="preset-meta">#${token}</div>
      </div>
      <div class="preset-meta">${item
        ? `P ${item.pan.toFixed(1)}° | T ${item.tilt.toFixed(1)}° | Z ${item.zoom.toFixed(1)}×`
        : '<span class="preset-empty">空槽位</span>'}
      </div>
      <div class="preset-actions">
        <button class="pbtn goto" ${item ? '' : 'disabled'} onclick="gotoPreset('${token}')">调用</button>
        <button class="pbtn save" onclick="savePreset('${token}')">保存</button>
        <button class="pbtn del" ${item ? '' : 'disabled'} onclick="deletePreset('${token}')">删除</button>
      </div>`;
    root.appendChild(card);
  }
}

async function loadPresets() {
  try {
    const r = await fetch(`${API}/presets`, { signal: AbortSignal.timeout(2000) });
    if (!r.ok) throw new Error();
    const data = await r.json();
    presetStore.clear();
    for (const item of (data.items || [])) presetStore.set(String(item.token), item);
  } catch (_) { presetStore.clear(); }
  renderPresets();
}

async function savePreset(token) {
  const current = presetStore.get(token);
  const name = window.prompt(`保存到预置位 ${token}，请输入名称：`, current?.name || presetLabel(token));
  if (name === null) return;
  try {
    const r = await fetch(`${API}/presets/${token}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, ptz: state }),
    });
    if (!r.ok) throw new Error(await r.text());
    await loadPresets();
    setApiStatus(true);
  } catch (e) { setApiStatus(false); }
}

async function gotoPreset(token) {
  try {
    const r = await fetch(`${API}/presets/${token}/goto`, { method: 'POST' });
    if (!r.ok) throw new Error(await r.text());
    const data = await r.json();
    if (data.item) {
      state.pan = data.item.pan; state.tilt = data.item.tilt; state.zoom = data.item.zoom;
      updateAll();
    }
    setApiStatus(true);
  } catch (e) { setApiStatus(false); }
}

async function deletePreset(token) {
  if (!window.confirm(`确认删除预置位 ${token}？`)) return;
  try {
    const r = await fetch(`${API}/presets/${token}`, { method: 'DELETE' });
    if (!r.ok) throw new Error(await r.text());
    await loadPresets();
    setApiStatus(true);
  } catch (e) { setApiStatus(false); }
}

// ── REST API communication ────────────────────────────────────
let sendTimer = null;
function scheduleApply() {
  clearTimeout(sendTimer);
  sendTimer = setTimeout(sendControl, 80);
}

async function sendControl() {
  if (isaacState !== 'running') return;
  try {
    const r = await fetch(`${API}/control`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ pan: state.pan, tilt: state.tilt, zoom: state.zoom }),
    });
    setApiStatus(r.ok);
  } catch { setApiStatus(false); }
}

function setApiStatus(ok) {
  const el = document.getElementById('p-api');
  el.textContent = ok ? 'API ✓' : 'API ✗';
  el.className   = 'pill ' + (ok ? 'ok' : 'err');
}

function setModelStatus(msg, ok = null) {
  modelStatusEl.textContent = msg;
  if (ok === true) modelStatusEl.style.color = '#00ff99';
  else if (ok === false) modelStatusEl.style.color = '#ff6b6b';
  else modelStatusEl.style.color = 'var(--text3)';
}

function renderModelActive(model) {
  if (!model) {
    modelActiveEl.textContent = '';
    return;
  }
  const scene = model.scene_path || '(未设置)';
  const cam = model.camera_prim || '(未设置)';
  modelActiveEl.textContent = `当前配置: ${scene} | ${cam}`;
}

async function loadModelConfig() {
  const btn = document.getElementById('model-refresh-btn');
  btn.disabled = true;
  setModelStatus('读取中...');
  try {
    const r = await fetch(MODEL_API, { signal: AbortSignal.timeout(3000) });
    const data = await r.json().catch(() => ({}));
    if (!r.ok || !data.ok) throw new Error(data.error || ('HTTP ' + r.status));
    const model = data.model || {};
    modelSceneInput.value = model.scene_path || '';
    modelCameraInput.value = model.camera_prim || '';
    renderModelActive(model);
    setModelStatus('已同步当前配置', true);
  } catch (err) {
    setModelStatus('读取失败: ' + formatFetchError(err), false);
  } finally {
    btn.disabled = false;
  }
}

async function applyModelConfig() {
  const btn = document.getElementById('model-apply-btn');
  const scenePath = modelSceneInput.value.trim();
  const cameraPrim = modelCameraInput.value.trim();
  const restartIfRunning = !!modelRestartInput.checked;
  if (!scenePath || !cameraPrim) {
    setModelStatus('请填写 scene_path 和 camera_prim', false);
    return;
  }

  btn.disabled = true;
  setModelStatus('提交中...');
  try {
    const r = await fetch(MODEL_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        scene_path: scenePath,
        camera_prim: cameraPrim,
        restart_if_running: restartIfRunning,
      }),
      signal: AbortSignal.timeout(5000),
    });
    const data = await r.json().catch(() => ({}));
    if (!r.ok || !data.ok) throw new Error(data.error || ('HTTP ' + r.status));
    renderModelActive(data.new || {});
    if (data.restart_triggered) setModelStatus('配置已更新，正在重启 Isaac 应用新模型...', true);
    else setModelStatus('配置已更新，将在下次启动时生效', true);
  } catch (err) {
    setModelStatus('应用失败: ' + formatFetchError(err), false);
  } finally {
    btn.disabled = false;
  }
}

function _setSelfcheckBadge(ok, text) {
  selfcheckBadgeEl.textContent = text;
  selfcheckBadgeEl.className = 'selfcheck-badge ' + (ok ? 'ok' : 'err');
}

function _setSelfcheckIdle(text) {
  selfcheckBadgeEl.textContent = text;
  selfcheckBadgeEl.className = 'selfcheck-badge';
}

function _fmtNum(v, digits = 2) {
  return typeof v === 'number' && Number.isFinite(v) ? v.toFixed(digits) : 'n/a';
}

function _buildSelfcheckSummary(data) {
  const pan = data.pan || {};
  const tilt = data.tilt || {};
  const zoom = data.zoom || {};
  return [
    `status=${data.selfcheck_status || 'n/a'}  camera=${data.camera_prim || 'n/a'}  upAxis=${data.scene_up_axis || 'n/a'}  pending=${data.ptz_dirty_pending ? 'yes' : 'no'}`,
    `pan: cmd=${_fmtNum(pan.cmd_deg, 1)}° zero=${_fmtNum(pan.zero_op_deg, 1)}° sign=${_fmtNum(pan.sign, 0)} exp=${_fmtNum(pan.expected_op_deg, 1)}° act=${_fmtNum(pan.actual_op_deg, 1)}° Δ=${_fmtNum(pan.delta_deg, 2)}°`,
    `tilt: cmd=${_fmtNum(tilt.cmd_deg, 1)}° zero=${_fmtNum(tilt.zero_op_deg, 1)}° sign=${_fmtNum(tilt.sign, 0)} exp=${_fmtNum(tilt.expected_op_deg, 1)}° act=${_fmtNum(tilt.actual_op_deg, 1)}° Δ=${_fmtNum(tilt.delta_deg, 2)}°`,
    `zoom: cmd=${_fmtNum(zoom.cmd_x, 2)}x sign=${_fmtNum(zoom.sign, 0)} expFL=${_fmtNum(zoom.expected_focal_length_mm, 3)}mm actFL=${_fmtNum(zoom.actual_focal_length_mm, 3)}mm Δ=${_fmtNum(zoom.delta_mm, 4)}mm`,
  ].join('\n');
}

async function runPtzSelfcheck() {
  const btn = document.getElementById('selfcheck-btn');
  if (isaacState !== 'running') {
    _setSelfcheckIdle('未就绪');
    selfcheckStatusEl.textContent = 'Isaac 未运行，无法自检。';
    selfcheckStatusEl.style.color = '#ff6b6b';
    return;
  }

  btn.disabled = true;
  _setSelfcheckIdle('检测中');
  selfcheckStatusEl.textContent = '正在读取 PTZ 自检信息...';
  selfcheckStatusEl.style.color = 'var(--text3)';
  try {
    const r = await fetch(PTZ_SELFCHECK_API, { signal: AbortSignal.timeout(3000) });
    const data = await r.json().catch(() => ({}));
    if (!r.ok || !data.ok) throw new Error(data.error || ('HTTP ' + r.status));
    selfcheckDetailsEl.textContent = _buildSelfcheckSummary(data);
    if (data.ptz_dirty_pending) {
      _setSelfcheckIdle('等待');
      selfcheckStatusEl.textContent = '检测到控制命令待应用，请稍后再试。';
      selfcheckStatusEl.style.color = 'var(--text3)';
    } else if (data.selfcheck_ok) {
      _setSelfcheckBadge(true, '通过');
      selfcheckStatusEl.textContent = '当前 PTZ 命令与 USD 实际写入一致。';
      selfcheckStatusEl.style.color = '#00ff99';
    } else {
      _setSelfcheckBadge(false, '异常');
      selfcheckStatusEl.textContent = '检测到 PTZ 写入偏差，请结合 details 查看。';
      selfcheckStatusEl.style.color = '#ff6b6b';
    }
  } catch (err) {
    _setSelfcheckBadge(false, '失败');
    selfcheckStatusEl.textContent = '自检失败: ' + formatFetchError(err);
    selfcheckStatusEl.style.color = '#ff6b6b';
    selfcheckDetailsEl.textContent = '';
  } finally {
    btn.disabled = false;
  }
}

// ── Isaac Sim 启停 ─────────────────────────────────────────────
async function toggleIsaac() {
  if (isaacState === 'stopped') {
    _applyIsaacState('starting');
    try {
      const r = await fetch(`${API}/start`, { method: 'POST' });
      if (!r.ok) throw new Error('HTTP ' + r.status);
    } catch (e) { _applyIsaacState('stopped'); }
  } else if (isaacState === 'running') {
    _applyIsaacState('stopping');
    try { await fetch(`${API}/stop`, { method: 'POST' }); } catch { /* pollStatus 会同步 */ }
  }
}

function _applyIsaacState(st) {
  isaacState = st;
  const btn    = document.getElementById('power-btn');
  const ovl    = document.getElementById('isaac-overlay');
  const ovlBtn = document.getElementById('ovl-start-btn');
  const pill   = document.getElementById('p-isaac');

  switch (st) {
    case 'stopped':
      btn.className = 'power-btn start'; btn.textContent = '⏻ 启动仿真'; btn.disabled = false;
      ovl.style.display = 'flex';
      ovlBtn.disabled = false; ovlBtn.textContent = '⏻ 启动仿真';
      pill.textContent = 'Isaac 已停止'; pill.className = 'pill neutral';
      setApiStatus(false);
      _setSelfcheckIdle('未就绪');
      selfcheckStatusEl.textContent = 'Isaac 未运行，无法自检。';
      selfcheckStatusEl.style.color = 'var(--text3)';
      selfcheckDetailsEl.textContent = '';
      break;
    case 'starting':
      btn.className = 'power-btn loading'; btn.textContent = '⏳ 启动中...'; btn.disabled = true;
      ovl.style.display = 'flex';
      ovlBtn.disabled = true; ovlBtn.textContent = '⏳ 加载中 (60~120s)...';
      pill.textContent = 'Isaac 启动中'; pill.className = 'pill warn';
      _pollLog();
      break;
    case 'running':
      btn.className = 'power-btn stop'; btn.textContent = '⏹ 停止仿真'; btn.disabled = false;
      ovl.style.display = 'none';
      pill.textContent = 'Isaac 运行中'; pill.className = 'pill ok';
      setTimeout(syncSceneState, 500);
      setTimeout(loadPresets, 200);
      break;
    case 'stopping':
      btn.className = 'power-btn loading'; btn.textContent = '⏳ 停止中...'; btn.disabled = true;
      pill.textContent = 'Isaac 停止中'; pill.className = 'pill warn';
      _setSelfcheckIdle('等待');
      selfcheckStatusEl.textContent = 'Isaac 正在停止，自检暂不可用。';
      selfcheckStatusEl.style.color = 'var(--text3)';
      break;
  }
}

let _logPollTimer = null;
async function _pollLog() {
  clearTimeout(_logPollTimer);
  if (isaacState !== 'starting') return;
  try {
    const r = await fetch(`${API}/log`);
    if (r.ok) {
      const txt   = await r.text();
      const lines = txt.split('\n').filter(l => l.trim());
      const last  = lines.slice(-3).join(' | ');
      const el = document.getElementById('ovl-log');
      if (el) el.textContent = last.slice(-120);
    }
  } catch { /* ignore */ }
  _logPollTimer = setTimeout(_pollLog, 3000);
}

// ── 状态轮询 ───────────────────────────────────────────────────
async function pollStatus() {
  try {
    const r = await fetch(`${API}/status`, { signal: AbortSignal.timeout(2000) });
    if (!r.ok) return;
    const s = await r.json();
    if (s.isaac_state && s.isaac_state !== isaacState) _applyIsaacState(s.isaac_state);
    if (s.isaac_state === 'running' && s.ptz && !dragging) {
      state.pan = s.ptz.pan; state.tilt = s.ptz.tilt; state.zoom = s.ptz.zoom;
      updateAll();
    }
    if (s.isaac_state === 'running') setApiStatus(true);
  } catch { /* ignore */ }
}
setInterval(pollStatus, 3000);

// ── Utility controls ──────────────────────────────────────────
function nudge(axis, delta) {
  const [lo, hi] = LIMITS[axis];
  state[axis] = clamp(state[axis] + delta, lo, hi);
  updateAll(); scheduleApply();
}
function setZoom(z) {
  state.zoom = clamp(z, 1, 32);
  updateAll(); scheduleApply();
}
function resetPT() {
  state.pan = -56; state.tilt = 9;
  updateAll(); sendControl();
}
function go(pan, tilt, zoom) {
  state.pan = pan; state.tilt = tilt; state.zoom = zoom;
  updateAll(); sendControl();
}

// ── Keyboard shortcuts ────────────────────────────────────────
document.addEventListener('keydown', e => {
  if (e.target.tagName === 'INPUT') return;
  const map = {
    'ArrowLeft':  () => nudge('pan',  -5),
    'ArrowRight': () => nudge('pan',   5),
    'ArrowUp':    () => nudge('tilt', -5),
    'ArrowDown':  () => nudge('tilt',  5),
    '+':          () => nudge('zoom',  1),
    '=':          () => nudge('zoom',  1),
    '-':          () => nudge('zoom', -1),
    'Home':       () => go(-56, 9, 1),
  };
  if (map[e.key]) { e.preventDefault(); map[e.key](); }
});

