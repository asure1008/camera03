// ── 日志工具 ───────────────────────────────────────────────────
function appendLog(elId, msg, cls = '') {
  const el = document.getElementById(elId);
  if (!el) return;
  const line = document.createElement('div');
  if (cls) line.className = 'log-' + cls;
  line.textContent = `[${new Date().toLocaleTimeString('zh-CN', { hour12: false })}] ${msg}`;
  el.appendChild(line);
  el.scrollTop = el.scrollHeight;
  // 最多保留 30 条
  while (el.children.length > 30) el.removeChild(el.firstChild);
}

// ── 模式切换 ───────────────────────────────────────────────────
function switchMode(mode) {
  onvif.mode = mode;
  document.getElementById('tab-local').classList.toggle('active', mode === 'local');
  document.getElementById('tab-ext').classList.toggle('active', mode === 'ext');
  const extSection = document.getElementById('svc-urls-section');
  extSection.style.display = mode === 'ext' ? 'block' : 'none';

  if (mode === 'local') {
    document.getElementById('input-device-svc').value = DEFAULT_DEVICE_SVC;
    document.getElementById('input-media-svc').value  = DEFAULT_MEDIA_SVC;
    document.getElementById('input-ptz-svc').value    = DEFAULT_PTZ_SVC;
    onvif.deviceSvc = DEFAULT_DEVICE_SVC;
    onvif.mediaSvc  = DEFAULT_MEDIA_SVC;
    onvif.ptzSvc    = DEFAULT_PTZ_SVC;
  }
}

// ── SOAP Builder ──────────────────────────────────────────────
function buildSoap(bodyXml, ns = {}) {
  const nsStr = Object.entries({
    's':    'http://www.w3.org/2003/05/soap-envelope',
    'tds':  'http://www.onvif.org/ver10/device/wsdl',
    'trt':  'http://www.onvif.org/ver10/media/wsdl',
    'tptz': 'http://www.onvif.org/ver20/ptz/wsdl',
    'tt':   'http://www.onvif.org/ver10/schema',
    ...ns,
  }).map(([k, v]) => `xmlns:${k}="${v}"`).join(' ');

  return `<?xml version="1.0" encoding="UTF-8"?>
<s:Envelope ${nsStr}>
  <s:Body>
    ${bodyXml}
  </s:Body>
</s:Envelope>`;
}

// ── 代理判断（本机服务直连；外部设备走 /onvif-proxy）────────────
function isSameOrigin(url) {
  try {
    const u = new URL(url, location.href);
    return u.origin === location.origin;
  } catch { return false; }
}

function isCurrentServiceUrl(url) {
  try {
    const u = new URL(url, location.href);
    return (
      u.origin === location.origin ||
      u.origin === new URL(DEFAULT_DEVICE_SVC).origin ||
      u.origin === new URL(DEFAULT_MEDIA_SVC).origin ||
      u.origin === new URL(DEFAULT_PTZ_SVC).origin
    );
  } catch { return false; }
}

function buildProxyHeaders(extra = {}) {
  const headers = { ...extra };
  const user = document.getElementById('input-user').value.trim();
  const pass = document.getElementById('input-pass').value;
  if (user || pass) {
    headers.Authorization = `Basic ${btoa(`${user}:${pass}`)}`;
  }
  return headers;
}

async function soapRequest(url, soapXml, action = '') {
  if (onvif.mode === 'ext' && !isCurrentServiceUrl(url)) {
    // 外部设备：通过代理转发
    const r = await fetch(`${API}/onvif-proxy`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        mode: 'soap',
        target_url: url,
        body: soapXml,
        headers: buildProxyHeaders({
          'Content-Type': 'application/soap+xml; charset=utf-8',
          ...(action ? { SOAPAction: action } : {}),
        }),
      }),
      signal: AbortSignal.timeout(8000),
    });
    if (!r.ok) throw new Error(`代理错误 ${r.status}: ${await r.text()}`);
    return await r.text();
  } else {
    // 本机服务：直接发 SOAP
    const r = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/soap+xml; charset=utf-8',
        ...(action ? { 'SOAPAction': action } : {}),
      },
      body: soapXml,
      signal: AbortSignal.timeout(8000),
    });
    if (!r.ok) throw new Error(`HTTP ${r.status}`);
    return await r.text();
  }
}

// XML 解析工具
function parseXml(text) {
  return new DOMParser().parseFromString(text, 'text/xml');
}
function xmlText(doc, ...tags) {
  for (const tag of tags) {
    const el = doc.querySelector(tag) || [...doc.getElementsByTagNameNS('*', tag)][0];
    if (el) return el.textContent.trim();
  }
  return '';
}

// ── 连接测试 ───────────────────────────────────────────────────
async function testConnection() {
  const btn = document.getElementById('btn-connect');
  btn.disabled = true;
  btn.textContent = '连接中...';

  const deviceSvc = document.getElementById('input-device-svc').value.trim() || DEFAULT_DEVICE_SVC;
  onvif.deviceSvc = deviceSvc;

  document.getElementById('log-connect').innerHTML = '';
  document.getElementById('device-info').classList.remove('visible');

  try {
    // Step 1: GetSystemDateAndTime
    appendLog('log-connect', 'GetSystemDateAndTime...', 'info');
    const dtSoap = buildSoap('<tds:GetSystemDateAndTime/>');
    await soapRequest(deviceSvc, dtSoap);
    appendLog('log-connect', '时钟获取成功', 'ok');

    // Step 2: GetCapabilities
    appendLog('log-connect', 'GetCapabilities...', 'info');
    const capSoap = buildSoap('<tds:GetCapabilities><tds:Category>All</tds:Category></tds:GetCapabilities>');
    const capXml  = await soapRequest(deviceSvc, capSoap);
    const capDoc  = parseXml(capXml);

    // 自动解析服务地址
    const mediaXAddr = xmlText(capDoc, 'Media') ? '' : '';
    const allXAddrs = [...capDoc.getElementsByTagNameNS('*', 'XAddr')].map(e => e.textContent.trim());
    let mediaSvcUrl = DEFAULT_MEDIA_SVC;
    let ptzSvcUrl   = DEFAULT_PTZ_SVC;

    // 根据 Capabilities 中的节点类型推断地址
    const caps = capDoc.querySelector('Capabilities') || capDoc.querySelector('GetCapabilitiesResponse');
    if (caps) {
      const mediaNode = [...caps.getElementsByTagNameNS('*', 'Media')][0];
      const ptzNode   = [...caps.getElementsByTagNameNS('*', 'PTZ')][0];
      if (mediaNode) {
        const xa = [...mediaNode.getElementsByTagNameNS('*', 'XAddr')][0];
        if (xa && xa.textContent.trim()) mediaSvcUrl = xa.textContent.trim();
      }
      if (ptzNode) {
        const xa = [...ptzNode.getElementsByTagNameNS('*', 'XAddr')][0];
        if (xa && xa.textContent.trim()) ptzSvcUrl = xa.textContent.trim();
      }
    }

    onvif.mediaSvc = mediaSvcUrl;
    onvif.ptzSvc   = ptzSvcUrl;
    document.getElementById('input-media-svc').value = mediaSvcUrl;
    document.getElementById('input-ptz-svc').value   = ptzSvcUrl;
    appendLog('log-connect', `Media: ${mediaSvcUrl.split('/').pop()}`, 'ok');
    appendLog('log-connect', `PTZ:   ${ptzSvcUrl.split('/').pop()}`, 'ok');

    // Step 3: GetDeviceInformation
    appendLog('log-connect', 'GetDeviceInformation...', 'info');
    const diSoap = buildSoap('<tds:GetDeviceInformation/>');
    const diXml  = await soapRequest(deviceSvc, diSoap);
    const diDoc  = parseXml(diXml);
    document.getElementById('di-mfr').textContent   = xmlText(diDoc, 'Manufacturer')   || '—';
    document.getElementById('di-model').textContent = xmlText(diDoc, 'Model')           || '—';
    document.getElementById('di-fw').textContent    = xmlText(diDoc, 'FirmwareVersion') || '—';
    document.getElementById('di-sn').textContent    = xmlText(diDoc, 'SerialNumber')    || '—';

    // Step 4: GetProfiles
    appendLog('log-connect', 'GetProfiles...', 'info');
    const profSoap = buildSoap('<trt:GetProfiles/>');
    const profXml  = await soapRequest(mediaSvcUrl, profSoap);
    const profDoc  = parseXml(profXml);
    const profileEl = [...profDoc.getElementsByTagNameNS('*', 'Profiles')][0]
                   || [...profDoc.getElementsByTagNameNS('*', 'Profile')][0];
    if (profileEl) {
      const token = profileEl.getAttribute('token') || 'PTZProfile_1';
      onvif.profileToken = token;
      document.getElementById('di-token').textContent = token;
    }

    onvif.connected = true;
    document.getElementById('di-status').textContent = '已连接';
    document.getElementById('device-info').classList.add('visible');
    appendLog('log-connect', '连接成功 ✓', 'ok');

  } catch (e) {
    appendLog('log-connect', `连接失败: ${e.message}`, 'err');
  } finally {
    btn.disabled = false;
    btn.textContent = '⚡ 测试连接';
  }
}

// ── ONVIF AbsoluteMove ─────────────────────────────────────────
async function onvifAbsoluteMove() {
  const pan  = parseFloat(document.getElementById('onvif-pan').value)  || 0;
  const tilt = parseFloat(document.getElementById('onvif-tilt').value) || 0;
  const zoom = parseFloat(document.getElementById('onvif-zoom').value) || 0;

  const panC  = clamp(pan,  -1, 1);
  const tiltC = clamp(tilt, -1, 1);
  const zoomC = clamp(zoom,  0, 1);

  const ptzSvc = (onvif.mode === 'ext'
    ? document.getElementById('input-ptz-svc').value.trim()
    : DEFAULT_PTZ_SVC) || DEFAULT_PTZ_SVC;

  appendLog('log-ptz', `AbsoluteMove pan=${panC} tilt=${tiltC} zoom=${zoomC}`, 'info');

  const soap = buildSoap(`
    <tptz:AbsoluteMove>
      <tptz:ProfileToken>${onvif.profileToken}</tptz:ProfileToken>
      <tptz:Position>
        <tt:PanTilt x="${panC}" y="${tiltC}" space="http://www.onvif.org/ver10/tptz/PanTiltSpaces/PositionGenericSpace"/>
        <tt:Zoom x="${zoomC}" space="http://www.onvif.org/ver10/tptz/ZoomSpaces/PositionGenericSpace"/>
      </tptz:Position>
    </tptz:AbsoluteMove>`);

  try {
    await soapRequest(ptzSvc, soap);
    appendLog('log-ptz', 'AbsoluteMove 成功 ✓', 'ok');
    // 同步到摇杆：触发 pollStatus 拿后端已转换的角度值
    setTimeout(pollStatus, 300);
  } catch (e) {
    appendLog('log-ptz', `失败: ${e.message}`, 'err');
  }
}

