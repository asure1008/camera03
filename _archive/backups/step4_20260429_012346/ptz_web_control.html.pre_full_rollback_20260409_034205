// ── ONVIF Snapshot ────────────────────────────────────────────
async function onvifSnapshot() {
  const btn = document.getElementById('btn-snap');
  btn.disabled = true; btn.textContent = '抓图中...';

  const mediaSvc = (onvif.mode === 'ext'
    ? document.getElementById('input-media-svc').value.trim()
    : DEFAULT_MEDIA_SVC) || DEFAULT_MEDIA_SVC;

  document.getElementById('log-snap').innerHTML = '';
  appendLog('log-snap', 'GetSnapshotUri...', 'info');

  try {
    // Step 1: GetSnapshotUri
    const soap = buildSoap(`
      <trt:GetSnapshotUri>
        <trt:ProfileToken>${onvif.profileToken}</trt:ProfileToken>
      </trt:GetSnapshotUri>`);

    const respXml = await soapRequest(mediaSvc, soap);
    const doc = parseXml(respXml);
    const uriEl = [...doc.getElementsByTagNameNS('*', 'Uri')][0];
    if (!uriEl) throw new Error('响应中未找到 Uri 字段');

    const snapUrl = uriEl.textContent.trim();
    if (!snapUrl) throw new Error('快照 URI 为空');

    appendLog('log-snap', `URI: ${snapUrl}`, 'info');

    // Step 2: 拉取图片
    let imgBlob;
    const snapFetchUrl = snapUrl + (snapUrl.includes('?') ? '&' : '?') + '_t=' + Date.now();
    if (onvif.mode !== 'ext' || isCurrentServiceUrl(snapUrl) || isSameOrigin(snapUrl)) {
      const r = await fetch(snapFetchUrl, { signal: AbortSignal.timeout(8000) });
      if (!r.ok) throw new Error(`图片 GET 失败: ${r.status}`);
      imgBlob = await r.blob();
    } else {
      // 外部设备快照：通过代理
      const r = await fetch(`${API}/onvif-proxy`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          mode: 'snapshot',
          target_url: snapFetchUrl,
          headers: buildProxyHeaders(),
        }),
        signal: AbortSignal.timeout(10000),
      });
      if (!r.ok) throw new Error(`代理抓图失败: ${r.status}`);
      imgBlob = await r.blob();
    }

    const blobUrl = URL.createObjectURL(imgBlob);
    const imgEl   = document.getElementById('snap-img');
    // 释放旧的 blob URL
    if (imgEl.src && imgEl.src.startsWith('blob:')) URL.revokeObjectURL(imgEl.src);
    imgEl.src = blobUrl;

    const dlEl = document.getElementById('snap-dl');
    dlEl.href     = blobUrl;
    dlEl.download = `snapshot_${Date.now()}.jpg`;

    const timeStr = new Date().toLocaleTimeString('zh-CN', { hour12: false });
    document.getElementById('snap-time').textContent = timeStr;
    document.getElementById('snap-url-display').textContent = snapUrl;

    document.getElementById('snap-preview').classList.add('visible');
    appendLog('log-snap', `抓图成功 ✓ (${(imgBlob.size / 1024).toFixed(1)} KB)`, 'ok');

  } catch (e) {
    appendLog('log-snap', `抓图失败: ${e.message}`, 'err');
  } finally {
    btn.disabled = false; btn.textContent = '📷 抓图';
  }
}

