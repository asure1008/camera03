}

let _gondolaTimer = null;
function scheduleGondola() {
  clearTimeout(_gondolaTimer);
  _gondolaTimer = setTimeout(sendGondola, 80);
}
async function sendGondola() {
  if (isaacState !== 'running') return;
  try {
    await fetch(`${API}/scene/gondola`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ y: sceneState.gondola_y }),
    });
