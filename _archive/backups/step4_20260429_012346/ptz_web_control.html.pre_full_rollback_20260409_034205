}

const WORKER_HINTS = [
  '工人全部隐藏',
  '显示 1 名工人，可配合“手动随机”切换',
  '两人均显示，Y 跟随吊篮',
];
function setWorkers(n, opts = {}) {
  const send = opts.send !== false;
  sceneState.workers = n;
  document.getElementById('workers-val').textContent = n + ' 人';
  document.getElementById('workers-hint').textContent = WORKER_HINTS[n];
  [0, 1, 2].forEach(i => document.getElementById(`wbtn-${i}`).classList.toggle('active', i === n));
  updateManualRandomAvailability();
  if (send) sendWorkers();
}
function updateManualRandomAvailability() {
  const btn = document.getElementById('manual-random-btn');
  if (!btn) return;
  btn.disabled = isaacState !== 'running' || sceneState.workers !== 1;
}
function renderManualRandomStatus(summary, isError = false) {
  const el = document.getElementById('workers-random-status');
  if (!el) return;
  if (!summary) {
    el.textContent = sceneState.workers === 1
      ? '点击“手动随机”可重新选择当前显示工人'
      : '切到“1 人”后可手动随机切换工人';
    el.style.color = 'var(--text2)';
    return;
  }
  if (isError) {
    el.textContent = summary.message || String(summary);
    el.style.color = 'var(--danger)';
    return;
  }
  const reqId = summary.req_id || '-';
  const workerLabel = summary.selected_worker_index ? `worker#${summary.selected_worker_index}` : 'none';
  const pathLabel = summary.selected_worker_path || 'n/a';
  el.textContent = `${reqId} | ${workerLabel} | ${pathLabel}`;
  el.style.color = 'var(--accent2)';
}
function applySceneStateResponse(s) {
  if (!s) return;
  if (s.gondola_y !== undefined) {
    sceneState.gondola_y = s.gondola_y;
    document.getElementById('gondola-slider').value = s.gondola_y;
    document.getElementById('gondola-val').textContent = s.gondola_y.toFixed(0) + ' cm';
    document.getElementById('gondola-num').value = s.gondola_y.toFixed(0);
  }
  if (s.workers !== undefined) setWorkers(s.workers, { send: false });
  if (s.last_manual_random) {
    sceneState.lastManualRandom = s.last_manual_random;
    renderManualRandomStatus(s.last_manual_random);
  } else if (!sceneState.lastManualRandom) {
    renderManualRandomStatus(null);
  }
}
async function sendWorkers() {
  if (isaacState !== 'running') return;
  try {
    const r = await fetch(`${API}/scene/workers`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ count: sceneState.workers }),
    });
    const data = await r.json().catch(() => ({}));
    if (!r.ok || data.ok === false) throw new Error(data.error || ('HTTP ' + r.status));
    applySceneStateResponse(data.state);
    setApiStatus(true);
  } catch {
    setApiStatus(false);
  }
}
async function manualRandom() {
  if (isaacState !== 'running') return;
  const btn = document.getElementById('manual-random-btn');
  if (btn) btn.disabled = true;
  try {
    const r = await fetch(`${API}/scene/manual-random`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ source: 'web' }),
    });
    const data = await r.json().catch(() => ({}));
    if (!r.ok || data.ok === false) throw new Error(data.error || ('HTTP ' + r.status));
    if (data.state) applySceneStateResponse(data.state);
    sceneState.lastManualRandom = data.summary || null;
    renderManualRandomStatus(sceneState.lastManualRandom);
    setApiStatus(true);
  } catch (e) {
    renderManualRandomStatus({ message: e.message || '手动随机失败' }, true);
    setApiStatus(false);
  } finally {
    updateManualRandomAvailability();
  }
}
async function syncSceneState() {
  if (isaacState !== 'running') return;
  try {
    const r = await fetch(`${API}/scene/state`, { signal: AbortSignal.timeout(2000) });
    if (!r.ok) return;
    const s = await r.json();
    applySceneStateResponse(s);
  } catch { /* ignore */ }
}

