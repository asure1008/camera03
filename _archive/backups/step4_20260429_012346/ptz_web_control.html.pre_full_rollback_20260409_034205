<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PTZ 球机控制台</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg0: #080d16;
    --bg1: #0c1422;
    --bg2: #111d30;
    --bg3: #162033;
    --border: #1e3552;
    --accent: #00c8ff;
    --accent2: #00ffa3;
    --accent3: #ff6b35;
    --text: #c4d8ee;
    --text2: #7a9abf;
    --text3: #3a5a7a;
    --danger: #ff4466;
    --warn: #ffaa00;
    --glow: rgba(0,200,255,0.15);
    --onvif: #a78bfa;
    --onvif-glow: rgba(167,139,250,0.12);
  }

  body {
    background: var(--bg0);
    color: var(--text);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ─── Header ─────────────────────────────────────────────── */
  header {
    flex-shrink: 0;
    background: var(--bg1);
    border-bottom: 1px solid var(--border);
    padding: 0 16px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    z-index: 10;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent);
    white-space: nowrap;
  }
  .logo-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent2);
    box-shadow: 0 0 8px var(--accent2);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }

  .pills {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .pill {
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border-radius: 12px;
    border: 1px solid var(--border);
    color: var(--text2);
    white-space: nowrap;
    transition: all .3s;
  }
  .pill.ok      { border-color: var(--accent2); color: var(--accent2); }
  .pill.err     { border-color: var(--danger);  color: var(--danger);  }
  .pill.warn    { border-color: var(--warn);    color: var(--warn);    }
  .pill.neutral { border-color: var(--text3);   color: var(--text3);   }
  .pill.rtsp    { border-color: var(--accent3); color: var(--accent3); font-family: 'Courier New', monospace; font-size: 0.62rem; cursor: default; }

  /* ─── Power button ──────────────────────────────────────── */
  .power-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 14px;
    border: 1px solid;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all .2s;
    background: transparent;
    white-space: nowrap;
  }
  .power-btn:disabled { opacity: .45; cursor: default; }
  .power-btn.start { border-color: var(--accent2); color: var(--accent2); }
  .power-btn.start:not(:disabled):hover { background: rgba(0,255,163,.12); }
  .power-btn.stop  { border-color: var(--danger);  color: var(--danger);  }
  .power-btn.stop:not(:disabled):hover  { background: rgba(255,68,102,.12); }
  .power-btn.loading { border-color: var(--warn); color: var(--warn); animation: pulse 1.2s infinite; }

  /* ─── Isaac overlay (page-level) ───────────────────────── */
  #isaac-overlay {
    position: fixed;
    inset: 44px 0 0 0;
    background: rgba(8,13,22,.88);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    z-index: 100;
    backdrop-filter: blur(4px);
  }
  #isaac-overlay .ovl-icon { font-size: 3.5rem; }
  #isaac-overlay .ovl-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: .05em;
  }
  #isaac-overlay .ovl-sub {
    font-size: 0.75rem;
    color: var(--text3);
    max-width: 340px;
    text-align: center;
    line-height: 1.6;
  }
  #isaac-overlay .ovl-btn {
    margin-top: 8px;
    padding: 10px 28px;
    border-radius: 20px;
    border: 1px solid var(--accent2);
    color: var(--accent2);
    background: rgba(0,255,163,.08);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: .08em;
    cursor: pointer;
    transition: all .2s;
  }
  #isaac-overlay .ovl-btn:hover { background: rgba(0,255,163,.2); }
  #isaac-overlay .ovl-btn:disabled { opacity: .4; cursor: default; animation: pulse 1.2s infinite; }
  #isaac-overlay .ovl-log {
    font-size: 0.62rem;
    color: var(--text3);
    font-family: 'Courier New', monospace;
    margin-top: -8px;
    max-width: 340px;
    text-align: center;
  }

  /* ─── Main layout: 3-column ─────────────────────────────── */
  main {
    flex: 1;
    display: grid;
    grid-template-columns: 340px 1fr 280px;
    gap: 0;
    overflow: hidden;
  }

  .col {
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    border-right: 1px solid var(--border);
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .col:last-child { border-right: none; }
  .col::-webkit-scrollbar { width: 4px; }
  .col::-webkit-scrollbar-track { background: transparent; }
  .col::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

  /* ─── Card ──────────────────────────────────────────────── */
  .card {
    border-bottom: 1px solid var(--border);
    padding: 14px 16px;
    background: var(--bg1);
    flex-shrink: 0;
  }
  .card-title {
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text3);
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .card-title::before {
    content: '';
    display: block;
    width: 3px; height: 10px;
    background: var(--accent);
    border-radius: 2px;
  }
  .card-title.onvif-accent::before { background: var(--onvif); }
  .card-title.scene-accent::before { background: var(--warn); }

  /* ─── 2D Joystick ───────────────────────────────────────── */
  .joystick-wrap {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .joystick-area {
    position: relative;
    width: 176px;
    height: 176px;
    flex-shrink: 0;
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: crosshair;
    overflow: hidden;
    touch-action: none;
  }
  .joystick-area::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: -1px -1px;
  }
  .joystick-area::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(0,200,255,.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,200,255,.18) 1px, transparent 1px);
    background-size: 176px 176px;
    background-position: 50% 50%;
  }

  .joystick-dot {
    position: absolute;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(0,200,255,.25), 0 0 12px rgba(0,200,255,.5);
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: box-shadow .15s;
  }
  .joystick-area.dragging .joystick-dot {
    box-shadow: 0 0 0 5px rgba(0,200,255,.35), 0 0 20px rgba(0,200,255,.8);
  }

  .joystick-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-size: 0.55rem;
    color: var(--text3);
    font-family: 'Courier New', monospace;
  }
  .jl-n { position: absolute; top: 3px; left: 50%; transform: translateX(-50%); }
  .jl-s { position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); }
  .jl-w { position: absolute; left: 3px; top: 50%; transform: translateY(-50%); }
  .jl-e { position: absolute; right: 3px; top: 50%; transform: translateY(-50%); }

  .joystick-side {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .axis-readout {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 7px 10px;
  }
  .axis-label {
    font-size: 0.62rem;
    color: var(--text3);
    letter-spacing: .06em;
    margin-bottom: 2px;
  }
  .axis-value {
    font-family: 'Courier New', monospace;
    font-size: 1.1rem;
    color: var(--accent);
    letter-spacing: .04em;
  }

  .nudge-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }
  .nbtn {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text2);
    font-size: 0.65rem;
    padding: 5px 3px;
    cursor: pointer;
    text-align: center;
    transition: all .15s;
  }
  .nbtn:hover { border-color: var(--accent); color: var(--accent); background: var(--glow); }
  .nbtn:active { transform: scale(.95); }

  .reset-btn {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text3);
    font-size: 0.65rem;
    padding: 5px;
    cursor: pointer;
    text-align: center;
    transition: all .15s;
    grid-column: span 2;
  }
  .reset-btn:hover { border-color: var(--accent2); color: var(--accent2); }

  /* ─── Zoom slider ───────────────────────────────────────── */
  .zoom-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }
  .zoom-label { font-size: 0.75rem; color: var(--text); white-space: nowrap; }
  .zoom-val {
    font-family: 'Courier New', monospace;
    font-size: 1rem;
    color: var(--accent);
    min-width: 48px;
    text-align: right;
    flex-shrink: 0;
  }

  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 4px;
    background: var(--bg0);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
    border: 1px solid var(--border);
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    margin-top: -6px;
    box-shadow: 0 0 6px rgba(0,200,255,.5);
  }
  input[type="range"]::-moz-range-thumb {
    width: 16px; height: 16px;
    border-radius: 50%;
    background: var(--accent);
    cursor: pointer;
    border: none;
    box-shadow: 0 0 6px rgba(0,200,255,.5);
  }

  .zoom-btns { display: flex; gap: 5px; }
  .zbtn {
    flex: 1;
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text2);
    font-size: 0.7rem;
    padding: 6px 4px;
    cursor: pointer;
    text-align: center;
    transition: all .15s;
  }
  .zbtn:hover { border-color: var(--accent); color: var(--accent); background: var(--glow); }

  /* ─── Presets ───────────────────────────────────────────── */
  .preset-grid { display: grid; grid-template-columns: 1fr; gap: 8px; }
  .preset-card {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px;
    display: grid;
    gap: 6px;
  }
  .preset-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .preset-name { font-size: 0.82rem; color: var(--text); font-weight: 600; }
  .preset-meta { font-size: 0.66rem; color: var(--text3); font-family: 'Courier New', monospace; }
  .preset-actions { display: grid; grid-template-columns: 1.2fr .8fr .8fr; gap: 5px; }
  .pbtn {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--text);
    font-size: 0.72rem;
    padding: 8px 5px;
    cursor: pointer;
    text-align: center;
    transition: all .15s;
    white-space: nowrap;
    overflow: hidden;
  }
  .pbtn:hover { border-color: var(--accent); color: var(--accent); background: var(--glow); }
  .pbtn.goto { border-color: var(--accent2); color: var(--accent2); }
  .pbtn.save { border-color: var(--accent); color: var(--accent); }
  .pbtn.del  { border-color: #aa5566; color: #ff8ea1; }
  .pbtn:disabled { opacity: .35; cursor: default; }
  .preset-empty { color: var(--text3); font-size: 0.68rem; }

  /* ─── Info table ────────────────────────────────────────── */
  .info-table { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .info-key { font-size: 0.62rem; color: var(--text3); margin-bottom: 2px; letter-spacing: .04em; }
  .info-val { font-family: 'Courier New', monospace; font-size: 0.78rem; color: var(--text); word-break: break-all; }
  .info-val.ac { color: var(--accent); }
  .info-val.oc { color: var(--accent3); }

  /* ─── Keyboard hints ────────────────────────────────────── */
  .kbd-hint { font-size: 0.62rem; color: var(--text3); line-height: 1.7; padding-top: 4px; }
  kbd {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.6rem;
    color: var(--text2);
  }

  .model-card { border-color: rgba(0,183,255,.25); }
  .model-grid { display: grid; gap: 10px; }
  .model-key { font-size: 0.62rem; color: var(--text3); margin-bottom: 4px; letter-spacing: .04em; }
  .model-input {
    width: 100%;
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    padding: 9px 10px;
    font-size: 0.72rem;
    outline: none;
  }
  .model-input:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(0,183,255,.08); }
  .model-check { display: flex; gap: 8px; align-items: center; font-size: 0.68rem; color: var(--text2); }
  .model-actions { display: flex; gap: 8px; }
  .model-btn {
    flex: 1;
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.72rem;
    padding: 8px 10px;
    cursor: pointer;
    transition: all .15s;
  }
  .model-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--glow); }
  .model-status, .selfcheck-status {
    min-height: 16px;
    font-size: 0.62rem;
    color: var(--text3);
  }
  .model-active, .selfcheck-details {
    font-family: 'Courier New', monospace;
    font-size: 0.62rem;
    line-height: 1.55;
    color: var(--text3);
    white-space: pre-wrap;
    word-break: break-word;
  }
  .selfcheck-card { border-color: rgba(0,255,153,.25); }
  .selfcheck-row { display: flex; gap: 8px; align-items: center; }
  .selfcheck-btn {
    flex: 1;
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.72rem;
    padding: 8px 10px;
    cursor: pointer;
    transition: all .15s;
  }
  .selfcheck-btn:hover { border-color: #00ff99; color: #00ff99; }
  .selfcheck-badge {
    min-width: 76px;
    text-align: center;
    font-size: 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 8px;
    color: var(--text3);
    background: var(--bg0);
  }
  .selfcheck-badge.ok { border-color: #00ff99; color: #00ff99; }
  .selfcheck-badge.err { border-color: #ff6b6b; color: #ff6b6b; }

  /* ─── ONVIF Settings Module ─────────────────────────────── */
  .onvif-card { background: var(--bg1); border-color: rgba(167,139,250,.2); }

  .mode-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 14px;
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px;
  }
  .mode-tab {
    flex: 1;
    padding: 5px;
    border-radius: 4px;
    border: none;
    background: transparent;
    color: var(--text3);
    font-size: 0.68rem;
    cursor: pointer;
    transition: all .2s;
    text-align: center;
    letter-spacing: .04em;
  }
  .mode-tab.active { background: var(--bg2); color: var(--onvif); border: 1px solid rgba(167,139,250,.3); }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 3px;
    margin-bottom: 8px;
  }
  .form-label {
    font-size: 0.62rem;
    color: var(--text3);
    letter-spacing: .04em;
  }
  .form-input {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    font-size: 0.75rem;
    padding: 6px 8px;
    width: 100%;
    font-family: 'Courier New', monospace;
    transition: border-color .2s;
  }
  .form-input:focus { outline: none; border-color: var(--onvif); }
  .form-input::placeholder { color: var(--text3); }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-bottom: 8px;
  }

  .btn-primary {
    width: 100%;
    padding: 8px;
    border-radius: 6px;
    border: 1px solid var(--onvif);
    background: var(--onvif-glow);
    color: var(--onvif);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all .2s;
    letter-spacing: .04em;
  }
  .btn-primary:hover { background: rgba(167,139,250,.22); }
  .btn-primary:disabled { opacity: .4; cursor: default; }
  .btn-primary.accent2 { border-color: var(--accent2); color: var(--accent2); background: rgba(0,255,163,.06); }
  .btn-primary.accent2:hover { background: rgba(0,255,163,.14); }
  .btn-primary.warn { border-color: var(--warn); color: var(--warn); background: rgba(255,170,0,.06); }
  .btn-primary.warn:hover { background: rgba(255,170,0,.14); }

  .btn-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 6px;
  }

  .device-info {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px;
    margin-top: 8px;
    display: none;
  }
  .device-info.visible { display: block; }
  .device-info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .di-key { font-size: 0.6rem; color: var(--text3); margin-bottom: 1px; }
  .di-val { font-family: 'Courier New', monospace; font-size: 0.72rem; color: var(--text); word-break: break-all; }
  .di-val.ok { color: var(--accent2); }
  .di-val.accent { color: var(--onvif); }

  .onvif-log {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 8px;
    margin-top: 8px;
    font-family: 'Courier New', monospace;
    font-size: 0.62rem;
    color: var(--text3);
    max-height: 80px;
    overflow-y: auto;
    line-height: 1.5;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .onvif-log .log-ok   { color: var(--accent2); }
  .onvif-log .log-err  { color: var(--danger); }
  .onvif-log .log-info { color: var(--accent); }
  .onvif-log .log-warn { color: var(--warn); }

  .ptz-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 6px;
    margin-bottom: 8px;
  }
  .ptz-input-wrap { display: flex; flex-direction: column; gap: 2px; }
  .ptz-input-label { font-size: 0.6rem; color: var(--text3); }
  .ptz-input {
    background: var(--bg0);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--accent);
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    padding: 5px 6px;
    width: 100%;
    text-align: center;
  }
  .ptz-input:focus { outline: none; border-color: var(--onvif); }

  /* ─── Snapshot preview ──────────────────────────────────── */
  .snap-preview {
    margin-top: 8px;
    display: none;
    flex-direction: column;
    gap: 6px;
  }
  .snap-preview.visible { display: flex; }
  .snap-img-wrap {
    position: relative;
    background: #000;
    border: 1px solid var(--border);
    border-radius: 5px;
    overflow: hidden;
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .snap-img {
    max-width: 100%;
    max-height: 160px;
    object-fit: contain;
    display: block;
  }
  .snap-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
  }
  .snap-time { font-size: 0.6rem; color: var(--text3); font-family: 'Courier New', monospace; }
  .snap-dl {
